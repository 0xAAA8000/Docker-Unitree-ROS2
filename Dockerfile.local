# ========== base：全イメージ共通 ==========
FROM ros:humble-ros-base AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-desktop \
    ros-humble-pcl-conversions ros-humble-pcl-ros \
    ros-humble-tf2-ros ros-humble-tf2-eigen \
    ros-humble-xacro ros-humble-robot-state-publisher \
    ros-humble-teleop-twist-keyboard \
    ros-humble-navigation2 ros-humble-nav2-bringup ros-humble-slam-toolbox \
    libpcl-dev libeigen3-dev libomp-dev python3-dev python3-serial \
 && rm -rf /var/lib/apt/lists/*
# WSLg対応
RUN apt update && apt install -y --no-install-recommends \
    software-properties-common gnupg ca-certificates \
    patchelf gcc libc6-dev binutils python3 \
 && add-apt-repository -y ppa:kisak/turtle \
 && apt update \
 && apt install -y --no-install-recommends \
    libgl1-mesa-dri libglx-mesa0 libegl-mesa0 libgbm1 mesa-libgallium \
 && rm -rf /var/lib/apt/lists/*
# wsl-gpu は名前付きビルドコンテキスト (https://github.com/0xAAA8000/WSL-Qualcomm-GPU) から取得する
# 例: docker build --build-context wsl-gpu=https://github.com/0xAAA8000/WSL-Qualcomm-GPU.git ...
COPY --from=wsl-gpu glibc_compat.c setup.sh weaken_verneed.py /opt/wsl-gpu/
RUN gcc -O2 -shared -fPIC -o /usr/local/lib/libwsl_glibc_compat.so /opt/wsl-gpu/glibc_compat.c
WORKDIR /ros2_ws
COPY entrypoint-wsl.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

# ========== 共通ワークスペースを1回だけビルド ==========
FROM base AS common-build
COPY src/common /opt/common_ws/src
RUN . /opt/ros/humble/setup.sh && \
    cd /opt/common_ws && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    rm -rf log

# ========== l1 ==========
FROM base AS l1
ENV ROS2_TARGET=l1
COPY --from=common-build /opt/common_ws /opt/common_ws
COPY src/l1 /ros2_ws/src
RUN . /opt/ros/humble/setup.sh && . /opt/common_ws/install/setup.sh && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release && rm -rf build log

# ========== l2 ==========
FROM base AS l2
ENV ROS2_TARGET=l2
COPY --from=common-build /opt/common_ws /opt/common_ws
COPY src/l2 /ros2_ws/src
RUN . /opt/ros/humble/setup.sh && . /opt/common_ws/install/setup.sh && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release && rm -rf build log

# ========== sim ==========
FROM base AS sim
ENV ROS2_TARGET=sim \
    IGN_GAZEBO_RESOURCE_PATH=/ros2_ws/src/sim_gazebo/model \
    GALLIUM_DRIVER=d3d12
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-ros-gz ros-humble-sdformat-urdf ros-humble-ign-ros2-control ros-humble-rviz2 \
    ros-humble-ros2-controllers ros-humble-ros2-control ros-humble-ackermann-steering-controller \
 && rm -rf /var/lib/apt/lists/*
COPY --from=common-build /opt/common_ws /opt/common_ws
COPY src/sim /ros2_ws/src
RUN . /opt/ros/humble/setup.sh && . /opt/common_ws/install/setup.sh && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release && rm -rf log
