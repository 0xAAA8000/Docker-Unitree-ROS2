<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="unitree_lidar">
    <!-- 固定設置する場合は static を true にする -->
    <static>false</static>
    
    <link name="lidar_link">
      <!-- 視覚形状（外観） -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- 衝突判定（固定型なら省略しても動作します） -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- GPU LiDAR センサー -->
      <sensor name="unilidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>11</update_rate> <!-- 更新間隔 -->
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle> <!-- 水平FOV -->
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>18</samples>
              <resolution>1</resolution>
              <!-- Unitree L1/L2 の超広視野角（±45度） -->
              <min_angle>-0.785398</min_angle> <!-- 垂直FOV -->
              <max_angle>0.785398</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>50.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>unilidar/pointcloud</topic>
      </sensor>
      
      <!-- IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>250</update_rate>
        <topic>unilidar/imu</topic>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.002</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.002</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
  </model>
</sdf>
