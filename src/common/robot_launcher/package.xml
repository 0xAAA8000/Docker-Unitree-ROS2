<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_launcher</name>
  <version>0.0.0</version>
  <description>スマホからモード (目的地設定の自走, キャリブレーション) を選んで起動する</description>
  <maintainer email="root@todo.todo">root</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>robot_config</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_bringup</exec_depend>
  <exec_depend>robot_operation</exec_depend>
  <exec_depend>point_lio</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
